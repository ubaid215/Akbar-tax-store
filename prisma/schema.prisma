// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id              String          @id @default(cuid())
  // Client info (dynamic fields stored as JSON)
  clientName      String
  clientEmail     String
  clientPhone     String?
  customFields    Json?           // dynamic fields admin configures
  
  // Booking details
  serviceId       String?
  service         Service?        @relation(fields: [serviceId], references: [id])
  date            String          // "YYYY-MM-DD"
  startTime       String          // "HH:MM"
  endTime         String          // "HH:MM"
  notes           String?
  
  // Status & management
  status          BookingStatus   @default(PENDING)
  isBlocked       Boolean         @default(false) // admin manual block (show as busy)
  
  // Google Calendar
  calendarEventId String?
  isVirtual       Boolean         @default(false)
  meetLink        String?

  // Reminders
  sendReminder    Boolean         @default(false)
  reminderSent    Boolean         @default(false)
  reminderTime    Int?            // minutes before event
  
  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([date, status])
  @@index([clientEmail])
}

model Service {
  id          String    @id @default(cuid())
  name        String
  description String?
  duration    Int       // minutes
  price       Float?
  color       String    @default("#0040A8")
  isActive    Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
}

model Availability {
  id          String    @id @default(cuid())
  dayOfWeek   Int       // 0=Sun, 1=Mon ... 6=Sat
  isOpen      Boolean   @default(true)
  slots       TimeSlot[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([dayOfWeek])
}

model TimeSlot {
  id             String       @id @default(cuid())
  availabilityId String
  availability   Availability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
  startTime      String       // "HH:MM"
  endTime        String       // "HH:MM"
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      String   // "YYYY-MM-DD"
  reason    String?
  createdAt DateTime @default(now())
}

model AdminBlock {
  id              String   @id @default(cuid())
  date            String   // "YYYY-MM-DD"
  startTime       String   // "HH:MM"
  endTime         String   // "HH:MM"
  label           String?  // "Personal Meeting", "Lunch Break", etc.
  addToCalendar   Boolean  @default(false)
  calendarEventId String?
  createdAt       DateTime @default(now())

  @@index([date])
}

model Settings {
  id                  String   @id @default("singleton")
  
  // Business
  businessName        String   @default("Akbar Tax Store")
  businessEmail       String   @default("")
  businessPhone       String?
  timezone            String   @default("Asia/Karachi")
  
  // Booking config
  slotDuration        Int      @default(60)   // minutes
  bufferTime          Int      @default(0)    // minutes between bookings
  maxAdvanceBooking   Int      @default(30)   // days in advance
  minAdvanceBooking   Int      @default(24)   // hours before
  
  // Custom fields required from clients
  customFields        Json     @default("[]") // array of field configs
  bookingFormFields   Json     @default("[]") // dedicated dynamic booking fields
  
  // Emails
  confirmationSubject String   @default("Your Booking is Confirmed - Akbar Tax Store")
  rejectionSubject    String   @default("Booking Update - Akbar Tax Store")
  reminderSubject     String   @default("Reminder: Your Upcoming Appointment")
  
  // Google Calendar
  googleCalendarId    String?
  googleLinked        Boolean  @default(false)
  
  // Notifications
  adminEmailNotify    Boolean  @default(true)
  
  updatedAt           DateTime @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}
